// Manual bank-transfer ecommerce — data model.
//
// Invariant this schema is built to defend:
//   An Order becomes `paid` ONLY via a verified BankAlert, or via an explicit,
//   attributed admin action. Nothing a buyer submits can reach that transition.
//
// Money is stored as integer kobo (BigInt). Never floats — the matcher does
// exact equality on amounts, and float equality on money is a bug generator.

generator client {
  provider = "prisma-client-js"
  // Generated INTO THE REPO, not into node_modules.
  //
  // The default output is "wherever @prisma/client resolves to", which depends
  // on how the installer hoisted the monorepo. On a machine that nests a
  // second copy under apps/web/node_modules, `prisma generate` writes to the
  // root copy while the app imports the nested stub — and the failure is a
  // wall of implicit-any type errors that never mentions Prisma.
  //
  // An explicit in-repo path is the same on every machine, and does not depend
  // on @prisma/client's postinstall having been allowed to run (npm 11.11
  // gates install scripts, and Vercel does not run them).
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Fixed merch lines. An enum rather than a table: the set is small, stable,
/// and typo-proofing it at the DB level is worth more here than letting the
/// seller invent categories at runtime. Display names live in categories.ts.
enum Category {
  tshirts
  jerseys
  scarves
  caps
  tote_bags
}

enum OrderStatus {
  pending_payment
  paid
  expired
  manual_review
  cancelled
}

/// Reservations are three-state, not a boolean. `released` alone can't tell
/// "stock handed back because the order expired" from "stock permanently sold".
enum ReservationStatus {
  active // holding stock; order still pending_payment
  committed // order paid; ProductVariant.stockQuantity already decremented
  released // expired/cancelled; stock returned to the available pool
}

enum AlertParseStatus {
  pending // stored, not yet parsed
  matched // parsed and bound to an order
  unmatched // parsed cleanly, no order satisfied reference + amount
  parse_failed // could not extract amount and/or reference
  ignored // parsed as a debit / non-transaction mail
  rejected // failed sender or DKIM/SPF verification — never eligible to match
}

enum PaymentSource {
  bank_alert
  manual_admin
}

enum MessageDirection {
  inbound
  outbound
}

enum NotificationStatus {
  pending
  sent
  failed
  dead // exhausted retries; needs a human
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    Category
  description String
  /// Display/"from" price. The price actually charged is the variant's —
  /// an XL may legitimately cost more than an S. Never used for order totals.
  priceKobo   BigInt
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([active])
  /// Category listing pages: /shop/jerseys
  @@index([category, active])
}

/// The stocked unit, and the ONLY thing that carries stock.
///
/// Reservation operates on whatever is physically stocked. If a Jersey exists
/// in S/M/L/XL, reserving "1 Jersey" is meaningless and oversells — the buyer
/// reserves one Jersey/L. Products with no real size axis still get exactly one
/// variant ("One Size"), so every code path below is uniform and none of them
/// has to branch on "does this product have sizes".
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Shown to the buyer: "S", "M", "L", "XL", "One Size".
  label String
  /// Stable, human-readable, unique across the catalogue: "jersey-l".
  sku   String @unique

  priceKobo BigInt
  /// Physical stock on hand. Decremented only when an order is confirmed paid.
  /// Available-to-sell = stockQuantity - sum(active reservations).
  stockQuantity Int
  /// Size ordering within a product: S before M before L. Not alphabetical.
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems   OrderItem[]
  reservations StockReservation[]
  images       ProductImage[]

  /// One row per size per product; also what the seed upserts against.
  @@unique([productId, label])
  @@index([productId, active])
}

/// Product photography.
///
/// Two kinds of image live here, distinguished by whether `variantId` is set:
///
///   variantId = null  a product-level angle — the front and back of a tee,
///                     which look the same whichever size you buy.
///   variantId = set   a specific colourway — the purple cap is not the black
///                     cap photographed from another side, it is a different
///                     object, and showing the wrong one sells the wrong thing.
///
/// Keeping both in one table means the product page asks a single question
/// ("what should I show for the selected variant?") instead of branching on
/// which axis a category happens to vary along.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Path under apps/web/public, e.g. /products/caps/cap-black-godacity.png
  url String
  /// Real alt text. These are the product; a blind buyer gets nothing from "".
  alt String
  /// Display order. The front of a shirt must come before the back.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  /// Lets the seed upsert instead of duplicating on every run.
  @@unique([productId, url])
  @@index([productId, sortOrder])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id String @id @default(cuid())

  /// Human-typeable, unambiguous, e.g. ORD-7F3K2. The buyer types this into
  /// their bank's narration field, so the alphabet excludes 0/1/I/L/O/U.
  referenceCode String      @unique
  status        OrderStatus @default(pending_payment)
  totalKobo     BigInt

  buyerName       String
  /// E.164, e.g. +2348012345678. Normalized at write time.
  buyerPhone      String
  deliveryAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Reservation deadline (UTC). Displayed to the buyer in WAT.
  expiresAt DateTime

  paidAt        DateTime?
  paymentSource PaymentSource?

  /// Exactly one of these is set when paymentSource is bank_alert / manual_admin.
  /// The @unique on the alert id is a DB-level guarantee that a single bank
  /// alert can never confirm two different orders.
  confirmingBankAlertId String?    @unique
  confirmedByAdminId    String?
  confirmedByAdmin      AdminUser? @relation(fields: [confirmedByAdminId], references: [id])

  items         OrderItem[]
  reservations  StockReservation[]
  bankAlerts    BankAlert[]
  messages      WhatsAppMessage[]
  notifications Notification[]
  events        OrderEvent[]

  /// Expiry sweep: find pending orders past their deadline.
  @@index([status, expiresAt])
  /// Manual-review UI: find candidate orders for an unmatched alert by amount.
  @@index([status, totalKobo])
  @@index([buyerPhone])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity      Int
  /// Price snapshot at checkout. Catalog price changes must not rewrite history.
  unitPriceKobo BigInt
  /// Both snapshots, so an old order still reads correctly after a rename:
  /// "Jersey" + "L".
  nameSnapshot         String
  variantLabelSnapshot String

  @@unique([orderId, variantId])
  @@index([variantId])
}

model StockReservation {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity  Int
  status    ReservationStatus @default(active)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  settledAt DateTime?

  /// One reservation row per (order, variant) keeps commit/release idempotent.
  @@unique([orderId, variantId])
  /// Expiry sweep + available-stock computation.
  @@index([status, expiresAt])
  @@index([variantId, status])
}

// ---------------------------------------------------------------------------
// Bank alerts — the ONLY automated source of truth for "money arrived"
// ---------------------------------------------------------------------------

model BankAlert {
  id String @id @default(cuid())

  /// RFC 5322 Message-ID. Idempotency key: re-reading the same mail is a no-op.
  messageId   String @unique
  mailbox     String
  fromAddress String
  subject     String

  /// Full raw RFC822 source, kept verbatim. When a bank silently changes its
  /// template, this is the only thing that lets us rebuild the parser.
  rawSource String  @db.Text
  textBody  String? @db.Text
  htmlBody  String? @db.Text

  /// Sender verification gate. From: headers are trivially forged, so an alert
  /// with authVerified = false is NEVER eligible for automatic matching.
  authVerified Boolean @default(false)
  authDetail   String? @db.Text

  parserName       String?
  parserVersion    Int?
  parsedAmountKobo BigInt?
  parsedReference  String?
  parsedNarration  String? @db.Text
  parseStatus      AlertParseStatus @default(pending)
  /// Why a parse failed, or which heuristic matched. Read constantly in review.
  parseNotes       String? @db.Text

  receivedAt  DateTime
  processedAt DateTime?

  matchedOrderId String?
  matchedOrder   Order?  @relation(fields: [matchedOrderId], references: [id])

  createdAt DateTime @default(now())

  /// Manual-review queue: unmatched/failed alerts, newest first.
  @@index([parseStatus, receivedAt])
  @@index([parsedReference])
  @@index([matchedOrderId])
}

// ---------------------------------------------------------------------------
// Notifications — outbox. The web app writes rows; only the worker sends.
// ---------------------------------------------------------------------------

model Notification {
  id String @id @default(cuid())

  /// e.g. "order:<id>:paid:buyer". The unique constraint is what makes
  /// double-confirmation physically incapable of double-messaging.
  dedupeKey String  @unique
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  channel String @default("whatsapp")
  toPhone String
  body    String @db.Text

  status        NotificationStatus @default(pending)
  attempts      Int                @default(0)
  lastError     String?            @db.Text
  nextAttemptAt DateTime           @default(now())
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  @@index([status, nextAttemptAt])
}

model WhatsAppMessage {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  direction MessageDirection
  phone     String
  body      String           @db.Text
  /// WhatsApp's own message id — inbound dedupe across client reconnects.
  waMessageId String?        @unique
  /// Buyer-sent screenshots land here as evidence for a human. They are NEVER
  /// an input to payment confirmation.
  mediaPath   String?
  mediaMime   String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// e.g. created, reservation_committed, paid, expired, manual_review_opened
  type       String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  /// "system:matcher", "system:expiry", "admin:<id>"
  actor      String
  detail     Json?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  confirmedOrders Order[]
}
