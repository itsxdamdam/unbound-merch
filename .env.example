# ---- Database -------------------------------------------------------------
DATABASE_URL="postgresql://store:store@localhost:5432/store?schema=public"

# ---- Seller bank details (shown on the payment instructions page) ---------
SELLER_BANK_NAME="GTBank"
SELLER_ACCOUNT_NUMBER="0123456789"
SELLER_ACCOUNT_NAME="Acme Ventures Ltd"

# ---- IMAP alert mailbox --------------------------------------------------
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER="alerts@yourdomain.com"
IMAP_APP_PASSWORD=""
IMAP_MAILBOX="INBOX"
# Fallback poll interval when the server does not advertise IDLE.
IMAP_POLL_SECONDS="20"

# ---- Alert sender verification (SECURITY-CRITICAL) -----------------------
# Comma-separated domains allowed to originate a credit alert. An email from
# any other domain — or one whose DKIM/SPF does not pass for these domains —
# is stored as `rejected` and can never auto-confirm an order.
# Leave empty and NOTHING will auto-match; that is the safe default.
ALERT_SENDER_ALLOWLIST="gtbank.com,gtbplc.com"

# ---- WhatsApp ------------------------------------------------------------
# whatsapp-web.js session store. Must be a persistent volume, not ephemeral.
# Losing it forces a QR re-pair, and frequent re-pairing is itself a ban signal.
WHATSAPP_SESSION_PATH="./.wwebjs_auth"
SELLER_WHATSAPP_NUMBER="+2348012345678"

# Ban-risk pacing. Defaults are deliberately timid; raise them only after the
# number has run clean for a few weeks. See PROPOSAL.md.
WA_MIN_GAP_MS="8000"
WA_JITTER_MS="7000"
WA_HOURLY_CAP="40"
WA_DAILY_CAP="200"
WA_WARMUP_START_CAP="20"
WA_WARMUP_DAYS="14"
WA_QUIET_START_HOUR="22"
WA_QUIET_END_HOUR="7"

# Fallback channel used when the WhatsApp session is banned or disconnected.
# A ban must degrade the shop, not stop it.
FALLBACK_ALERT_EMAIL="seller@yourdomain.com"

# ---- WhatsApp driver -----------------------------------------------------
# `fake` prints messages to the worker console instead of sending them, so the
# whole flow runs locally with no QR pairing and no ban risk. `web` selects the
# real whatsapp-web.js session.
WHATSAPP_DRIVER="fake"

# ---- Business rules ------------------------------------------------------
RESERVATION_MINUTES="15"
DISPLAY_TIMEZONE="Africa/Lagos"

# ---- Admin ---------------------------------------------------------------
ADMIN_EMAIL="seller@yourdomain.com"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# ---- Internal service auth (web -> worker, worker -> web) ----------------
INTERNAL_API_TOKEN=""
